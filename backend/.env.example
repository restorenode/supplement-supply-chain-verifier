DATABASE_URL=sqlite:///./app.db
ADMIN_API_KEY=api-key
ENV=dev
# Network preset: base-sepolia (default), base, sepolia, ethereum, initia-evm.
# Presets supply chain ID, public RPC and block explorer; set the overrides below only to change them.
CHAIN_NETWORK=base-sepolia
# mock = local registry persisted to MOCK_CHAIN_PATH (no RPC, no keys); real = deployed contract
CHAIN_MODE=mock
CONTRACT_ADDRESS=
PUBLISHER_PRIVATE_KEY=
# Optional overrides of the preset
# CHAIN_RPC_URL=
# CHAIN_ID=
# CHAIN_EXPLORER_URL=
# CHAIN_LEGACY_TX=false
# MOCK_CHAIN_PATH=mock_chain.json
# mock = empty results (tests), demo = offline rule-based parser for sample COAs, openai = real LLM
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: regex of browser origins allowed to call the API (default: *.vercel.app + localhost on any port)
# CORS_ORIGIN_REGEX=
# Optional: max lab report upload size in bytes (default 20 MB)
# MAX_UPLOAD_BYTES=20971520
